// Equation Symbols
enum EQS
{
    ZERO,               // Number construction
    ONE,
    TWO,
    THREE,
    FOUR,
    FIVE,
    SIX,
    SEVEN,
    EIGHT,
    NINE,
    DECIMAL,
    OPEN_PARENTHESIS,   // Parentheses
    CLOSE_PARENTHESIS,
    PLUS,               // Core operators
    MINUS,
    MULTIPLY,
    DIVIDE,
    POWER,
    ROOT,
    LOG,
    SINE,
    COSINE,
    TANGENT,
    X1,                 // Variables
    X2,
    X3,
    X4,
    X5,
    X6,
    X7,
    X8,
    PI,                 // Special constants
    E,
    MOD,                // More operators
    ABSOLUTE_VALUE,
    ROUND,
}