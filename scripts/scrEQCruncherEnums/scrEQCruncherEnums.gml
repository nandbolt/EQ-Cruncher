// Equation Symbols
enum EQS
{
    ZERO = 0,               // Number construction
    ONE = 1,
    TWO = 2,
    THREE = 3,
    FOUR = 4,
    FIVE = 5,
    SIX = 6,
    SEVEN = 7,
    EIGHT = 8,
    NINE = 9,
    DECIMAL = 10,
    OPEN_PARENTHESIS = 11,   // Parentheses
    CLOSE_PARENTHESIS = 12,
    PLUS = 13,               // Core operators
    MINUS = 14,
    MULTIPLY = 15,
    DIVIDE = 16,
    POWER = 17,
    ROOT = 18,
    LOG = 19,
    SINE = 20,
    COSINE = 21,
    TANGENT = 22,
    X1 = 23,                 // Variables
    X2 = 24,
    X3 = 25,
    X4 = 26,
    X5 = 27,
    X6 = 28,
    X7 = 29,
    X8 = 30,
    PI = 31,                 // Special constants
    E = 32,
    MOD = 33,                // More operators
    ABSOLUTE_VALUE = 34,
    ROUND = 35,
}